# The variables the cloud reads from its environment. Copy this file to .env, which git
# ignores, and set what applies; never commit a real value. Docker Compose reads .env, and
# so does `uv run --env-file .env`.

# The configuration's environment: a file in config/environments/, such as development.
AI_CLOUD_ENVIRONMENT=development

# The configuration's directory, if not this checkout's config/ folder.
# AI_CLOUD_CONFIG_DIR=

# The protocols' folder, if not this checkout's platform/protocols (ai-platform).
# AI_CLOUD_PLATFORM_DIR=

# ---- Secrets ----
# Each may come from a file instead, as a secret store mounts it: the same name with
# _FILE, such as AI_CLOUD_DATABASE_URL_FILE=/run/secrets/database_url.

# PostgreSQL, as a postgresql:// URL. These values are the development database's, from
# deploy/compose.development.yaml, which listens on this machine only.
AI_CLOUD_DATABASE_URL=postgresql://ai_cloud:development@127.0.0.1:5432/ai_cloud

# Redis, as a redis:// URL; the development one, from the same file.
AI_CLOUD_REDIS_URL=redis://127.0.0.1:6379/0

# The keys that sign the cloud's own tokens: a JWK set, on one line, in single quotes.
# Make one with `uv run ai-cloud signing-key`.
AI_CLOUD_SIGNING_KEYS=
